<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Github_Downloader_lib.Models;assembly=Github-Downloader-lib"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="Github_Downloader.Views.RepoEntryControl"
             x:DataType="models:Repo">
    
    <UserControl.Styles>
        <Style Selector="Border.drag-handle">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.drag-handle:pointerover">
            <Setter Property="Background" Value="#3A3A42"/>
        </Style>
        <Style Selector="Ellipse.drag-dot">
            <Setter Property="Fill" Value="#9999A8"/>
        </Style>
        <Style Selector="Border.drag-handle:pointerover Ellipse.drag-dot">
            <Setter Property="Fill" Value="#A5DEE0"/>
        </Style>
    </UserControl.Styles>

    <Border Name="RepoCard" Background="#2B2B35" BorderBrush="#383842" BorderThickness="1"
            CornerRadius="8" Padding="12" Margin="0 0 0 8">
        <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto">
            <Border Name="DragHandle" Classes="drag-handle" Width="28" Height="42" CornerRadius="5"
                    Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                    ToolTip.Tip="Drag to reorder repositories" AutomationProperties.Name="Reorder repository"
                    PointerPressed="DragHandle_OnPointerPressed">
                <UniformGrid Columns="2" Rows="3" Width="12" Height="22">
                    <Ellipse Classes="drag-dot" Width="3" Height="3"/>
                    <Ellipse Classes="drag-dot" Width="3" Height="3"/>
                    <Ellipse Classes="drag-dot" Width="3" Height="3"/>
                    <Ellipse Classes="drag-dot" Width="3" Height="3"/>
                    <Ellipse Classes="drag-dot" Width="3" Height="3"/>
                    <Ellipse Classes="drag-dot" Width="3" Height="3"/>
                </UniformGrid>
            </Border>

            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                      VerticalAlignment="Center" 
                      Margin="0,0,15,0"/>
            
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#3D3D4D" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding CurrentVersion}" FontSize="12" Foreground="#CCC"/>
                    </Border>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsUpToDate}">
                        <TextBlock Text="→" Foreground="Orange" VerticalAlignment="Center"/>
                        <Border Background="#4D3D2D" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding Tag}" FontSize="12" Foreground="Orange" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Multiple assets match the rule." IsVisible="{Binding HasMultipleAssetRuleMatches}"
                               FontSize="12" Foreground="#CCC" VerticalAlignment="Center"/>
                    <TextBlock Text="No assets match the rule." IsVisible="{Binding HasNoAssetRuleMatches}"
                               FontSize="12" Foreground="#CCC" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding AssetNames}" 
                      SelectedIndex="{Binding DownloadAssetIndex}" 
                      IsEnabled="{Binding !HasAssetRule}"
                      ToolTip.Tip="Manual file selection. Edit or clear an asset rule in More."
                      Width="250" 
                      VerticalAlignment="Center" 
                      Margin="15,0"
                      MaxDropDownHeight="300"/>
            
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Name="BtnUpdate" Content="Update" IsEnabled="{Binding !IsUpToDate}" Click="BtnUpdate_OnClick"/>
                <Button Name="BtnMore" Content="More" Click="BtnMore_OnClick"/>
            </StackPanel>
            
            <Button Grid.Column="5"
                    Name="BtnRemove"
                    ToolTip.Tip="Stop tracking this repository (keeps the installed application)"
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="8"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemove_OnClick">
                <Image Source="avares://Github-Downloader/resources/trash.png" Width="20" Height="20" Opacity="0.6"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
