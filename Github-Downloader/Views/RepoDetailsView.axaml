<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Github_Downloader.ViewModels"
             xmlns:md="using:Markdown.Avalonia"
             xmlns:mdc="using:Markdown.Avalonia.Controls"
             xmlns:ctxt="using:ColorTextBlock.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Github_Downloader.Views.RepoDetailsView"
             x:DataType="viewModels:RepoDetailsViewModel"
             Background="#222226"
             Loaded="Control_OnLoaded">
    
    <Grid Margin="20" RowDefinitions="Auto,*">
        <Border CornerRadius="12" Padding="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#2B2B35" Offset="0"/>
                    <GradientStop Color="#313131" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Image Source="../resources/arrow_back.png" Width="30" Height="30" PointerPressed="BtnBack_OnClick" Cursor="Hand"/>
                <TextBlock Name="TbxRepoName" Text="Repo-name" Classes="Title" Grid.Column="1" Margin="20, 5" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" 
                    Name="TbxGithubLink" 
                    Text="View on GitHub" 
                    Foreground="#009EA4"
                    TextDecorations="Underline"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    PointerPressed="TbxGithubLink_OnPointerPressed"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0, 20, 0, 0" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="1*, 20, 1.5*" Margin="0, 0, 10, 0">
                <StackPanel Grid.Column="0" Spacing="20">
                    <Border CornerRadius="12" Padding="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                                <GradientStop Color="#2B2B35" Offset="0"/>
                                <GradientStop Color="#313131" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <StackPanel Spacing="15">
                            <TextBlock Text="Repository Information" Classes="SubTitle"/>
                            
                            <StackPanel Name="StpVersion" Spacing="10" Orientation="Horizontal">
                                <ComboBox Name="CobVersion" Width="150"/>
                                <TextBlock Name="TbxUpdateVersion" Text="UpdateVersion" Foreground="Orange" VerticalAlignment="Center"/>
                                <TextBlock Name="TbxVersion" Text="Version" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Spacing="10" Orientation="Horizontal">
                                <Button Name="BtnUpdate" Content="Update" Click="BtnUpdate_OnClick"/>
                                <Button Name="BtnReinstall" Content="Reinstall" Click="BtnReinstall_OnClick" Background="#444"/>
                            </StackPanel>
                            
                            <StackPanel Spacing="5">
                                <TextBlock Text="Description:" FontWeight="SemiBold"/>
                                <TextBlock Name="TbxDescription" TextWrapping="Wrap" Text="This is the description" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Padding="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                                <GradientStop Color="#2B2B35" Offset="0"/>
                                <GradientStop Color="#313131" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <StackPanel Name="StpSaveFileAnyway" Spacing="15">
                            <TextBlock Text="Download Settings" Classes="SubTitle"/>
                            
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Save file anyway" VerticalAlignment="Center"/>
                                <ToggleSwitch Name="TglSaveFileAnyway" Grid.Column="1" OnContent="" OffContent="" Click="TglSaveFileAnyway_OnClick"/>
                            </Grid>
                            
                            <StackPanel Name="StpDownloadPath" Spacing="10">
                                <TextBlock Text="Download Location" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Name="TbxDownloadPath" Text="/home/{user}" IsReadOnly="True"/>
                                    <Button Name="BtnFilePicker" Content="..." Grid.Column="1" Margin="10, 0, 0, 0" Click="BtnFilePicker_OnClick"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*, Auto" Margin="0, 5, 0, 0">
                                    <TextBlock Text="Rename file" VerticalAlignment="Center"/>
                                    <ToggleSwitch Name="TglRenameFile" Grid.Column="1" OnContent="" OffContent="" Click="TglRenameFile_OnClick"/>
                                </Grid>
                                <TextBox Name="TbxRenameFile" Watermark="New filename" TextChanged="TbxRenameFile_OnTextChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <Border Grid.Column="2" CornerRadius="12" Padding="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                            <GradientStop Color="#2B2B35" Offset="0"/>
                            <GradientStop Color="#313131" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <Grid RowDefinitions="Auto, Auto, *">
                        <Grid ColumnDefinitions="*, Auto" Margin="0, 0, 0, 15">
                            <TextBlock Text="Release Details" Classes="SubTitle"/>
                            <TextBlock Grid.Column="1" Name="TbxReleaseDate" Text="Release-date" Opacity="0.7" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Separator Grid.Row="1" Margin="0, 0, 0, 15" Background="#444"/>
                        
                        <StackPanel Grid.Row="2" Spacing="10">
                            <TextBlock Text="Changelog" FontWeight="SemiBold"/>
                            <md:MarkdownScrollViewer Name="MarkdownChangelog"
                                                     MarkdownStyleName="Empty"
                                                     SelectionEnabled="True"
                                                     SaveScrollValueWhenContentUpdated="True">
                                <md:MarkdownScrollViewer.Styles>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock">
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Foreground" Value="#E6E6E6"/>
                                        <Setter Property="Margin" Value="0,4,0,4"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock">
                                        <Setter Property="FontSize" Value="11.5"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading1">
                                        <Setter Property="FontSize" Value="22"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Margin" Value="0,10,0,6"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading2">
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#F4F4F4"/>
                                        <Setter Property="Margin" Value="0,10,0,6"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading3">
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#EFEFEF"/>
                                        <Setter Property="Margin" Value="0,8,0,4"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading4">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="DemiBold"/>
                                        <Setter Property="Margin" Value="0,6,0,2"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading5">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="DemiBold"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading6">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CHyperlink">
                                        <Setter Property="IsUnderline" Value="True"/>
                                        <Setter Property="Foreground" Value="#009EA4"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CCode">
                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace"/>
                                        <Setter Property="Foreground" Value="#E6C07B"/>
                                        <Setter Property="Background" Value="#2E2E3A"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.CodeBlock">
                                        <Setter Property="Background" Value="#26262E"/>
                                        <Setter Property="Margin" Value="0,4,0,4"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock.CodeBlock">
                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace"/>
                                        <Setter Property="Foreground" Value="#C8C8C8"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.List">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Blockquote">
                                        <Setter Property="BorderBrush" Value="#009EA4"/>
                                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer mdc|Rule">
                                        <Setter Property="Margin" Value="0,4"/>
                                    </Style>
                                </md:MarkdownScrollViewer.Styles>
                            </md:MarkdownScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
