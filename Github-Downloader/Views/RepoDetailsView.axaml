<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Github_Downloader.ViewModels"
             xmlns:md="using:Markdown.Avalonia.Full"
             xmlns:converters="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Github_Downloader.Views.RepoDetailsView"
             x:DataType="viewModels:RepoDetailsViewModel"
             Background="#222226"
             Loaded="Control_OnLoaded" Unloaded="Control_OnUnloaded">
    
    <Grid Margin="20" RowDefinitions="Auto,*">
        <Border CornerRadius="12" Padding="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#2B2B35" Offset="0"/>
                    <GradientStop Color="#313131" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Image Source="../resources/arrow_back.png" Width="30" Height="30" PointerPressed="BtnBack_OnClick" Cursor="Hand"/>
                <TextBlock Name="TbxRepoName" Text="Repo-name" Classes="Title" Grid.Column="1" Margin="20, 5" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" 
                    Name="TbxGithubLink" 
                    Text="View on GitHub" 
                    Foreground="#009EA4"
                    TextDecorations="Underline"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    PointerPressed="TbxGithubLink_OnPointerPressed"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0, 20, 0, 0" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="1*, 20, 1.5*" Margin="0, 0, 10, 0">
                <StackPanel Grid.Column="0" Spacing="20">
                    <Border CornerRadius="12" Padding="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                                <GradientStop Color="#2B2B35" Offset="0"/>
                                <GradientStop Color="#313131" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <StackPanel Spacing="15">
                            <TextBlock Text="Repository Information" Classes="SubTitle"/>
                            
                            <StackPanel Name="StpVersion" Spacing="10" Orientation="Horizontal">
                                <ComboBox Name="CobVersion" Width="150"/>
                                <TextBlock Name="TbxUpdateVersion" Text="UpdateVersion" Foreground="Orange" VerticalAlignment="Center"/>
                                <TextBlock Name="TbxVersion" Text="Version" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Release channel" FontWeight="SemiBold"/>
                            <ComboBox Name="CobReleaseChannel" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Stable releases only"/>
                                <ComboBoxItem Content="Stable releases and pre-releases"/>
                            </ComboBox>
                            <TextBlock Text="An explicit tag overrides the channel. Changing channels only checks releases; use Update to install."
                                       TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                            <TextBlock Text="{Binding Repo.ReleaseStatus}" IsVisible="{Binding !Repo.HasRelease}" TextWrapping="Wrap"/>
                            
                            <WrapPanel>
                                <Button Name="BtnUpdate" Content="Update" Click="BtnUpdate_OnClick" Margin="0,0,10,6"/>
                                <Button Name="BtnReinstall" Content="Reinstall" Click="BtnReinstall_OnClick" Background="#444" Margin="0,0,10,6"/>
                                <Button Content="Uninstall" Click="BtnUninstall_OnClick" IsVisible="{Binding Repo.CanUninstall}"
                                        Background="#963B3B" Margin="0,0,0,6"/>
                            </WrapPanel>
                            
                            <StackPanel Spacing="5">
                                <TextBlock Text="Description:" FontWeight="SemiBold"/>
                                <TextBlock Name="TbxDescription" TextWrapping="Wrap" Text="This is the description" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Padding="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                                <GradientStop Color="#2B2B35" Offset="0"/>
                                <GradientStop Color="#313131" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <StackPanel Spacing="15">
                            <TextBlock Text="Download Settings" Classes="SubTitle"/>

                            <TextBlock Text="Asset rule" FontWeight="SemiBold"/>
                            <TextBox Name="TbxAssetRule" Text="{Binding Repo.AssetRule, Mode=TwoWay}"
                                     PlaceholderText="e.g. *linux*x64*.AppImage" AcceptsReturn="True" MinLines="3" TextWrapping="Wrap"/>
                            <TextBlock Text="Separate case-sensitive globs with spaces or newlines: * matches any text, ? one character, {x64,amd64} either alias. Prefix a pattern with ! to exclude assets. Every inclusion must match; exclusions always win. At least one inclusion is required. Clear the rule to select a file manually."
                                       TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                            <ComboBox Name="CobAsset" ItemsSource="{Binding Repo.AssetNames}"
                                      SelectedIndex="{Binding Repo.DownloadAssetIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding !Repo.HasAssetRule}" HorizontalAlignment="Stretch"/>
                            <TextBlock Name="TbxAssetSelectionStatus" Text="{Binding Repo.AssetSelectionStatus}" TextWrapping="Wrap"/>
                            <ItemsControl Name="AssetRuleMatches" ItemsSource="{Binding Repo.AssetRuleMatches}" IsVisible="{Binding Repo.HasAssetRule}"/>
                            
                            <Grid Name="StpSaveFileAnyway" ColumnDefinitions="*, Auto">
                                <TextBlock Text="Save file anyway" VerticalAlignment="Center"/>
                                <ToggleSwitch Name="TglSaveFileAnyway" Grid.Column="1" OnContent="" OffContent=""
                                              IsChecked="{Binding Repo.SaveFileAnyway, Mode=TwoWay}"/>
                            </Grid>

                            <StackPanel Spacing="15">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static converters:BoolConverters.Or}">
                                        <Binding Path="!IsVisible" ElementName="StpSaveFileAnyway"/>
                                        <Binding Path="IsChecked" ElementName="TglSaveFileAnyway"/>
                                    </MultiBinding>
                                </StackPanel.IsVisible>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Auto-extract" VerticalAlignment="Center"/>
                                    <ToggleSwitch Name="TglAutoExtract" Grid.Column="1" OnContent="" OffContent=""
                                                  IsChecked="{Binding Repo.AutoExtract, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="Extracts archives into a repository folder inside Download Location. The archive file is not kept."
                                           IsVisible="{Binding Repo.AutoExtract}" TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                            </StackPanel>
                            
                            <StackPanel Name="StpDownloadPath" Spacing="10">
                                <TextBlock Text="Download Location" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Name="TbxDownloadPath" Text="/home/{user}" IsReadOnly="True"/>
                                    <Button Name="BtnFilePicker" Content="..." Grid.Column="1" Margin="10, 0, 0, 0" Click="BtnFilePicker_OnClick"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*, Auto" Margin="0, 5, 0, 0">
                                    <TextBlock Text="Rename file" VerticalAlignment="Center"/>
                                    <ToggleSwitch Name="TglRenameFile" Grid.Column="1" OnContent="" OffContent="" Click="TglRenameFile_OnClick"/>
                                </Grid>
                                <TextBox Name="TbxRenameFile" PlaceholderText="New filename" TextChanged="TbxRenameFile_OnTextChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <ThemeVariantScope Grid.Column="2" RequestedThemeVariant="Dark">
                    <Border CornerRadius="12" Padding="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                                <GradientStop Color="#2B2B35" Offset="0"/>
                                <GradientStop Color="#313131" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    
                        <Grid RowDefinitions="Auto, Auto, *">
                            <Grid ColumnDefinitions="*, Auto" Margin="0, 0, 0, 15">
                                <TextBlock Text="Release Details" Classes="SubTitle"/>
                                <TextBlock Grid.Column="1" Name="TbxReleaseDate" Text="Release-date" Opacity="0.7" VerticalAlignment="Center"/>
                            </Grid>
                        
                            <Separator Grid.Row="1" Margin="0, 0, 0, 15" Background="#444"/>
                        
                            <StackPanel Grid.Row="2" Spacing="10">
                                <TextBlock Text="Changelog" FontWeight="SemiBold"/>
                                <md:MarkdownScrollViewer Name="MarkdownChangelog"
                                                         MarkdownStyleName="FluentTheme"
                                                         SelectionEnabled="True"
                                                         SaveScrollValueWhenContentUpdated="True">
                                    <md:MarkdownScrollViewer.Styles>
                                        <StyleInclude Source="/Styles/ChangelogStyles.axaml"/>
                                    </md:MarkdownScrollViewer.Styles>
                                </md:MarkdownScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ThemeVariantScope>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
