<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:Github_Downloader.ViewModels"
             xmlns:views="clr-namespace:Github_Downloader.Views"
             xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Github_Downloader.Views.HomeView"
             x:DataType="viewModel:HomeViewModel"
             Background="#222226"
             Loaded="Control_OnLoaded">
    
  <Grid RowDefinitions="Auto,*" Margin="20">
      <Border CornerRadius="12" Padding="16">
          <Border.Background>
              <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                  <GradientStop Color="#2B2B35" Offset="0"/>
                  <GradientStop Color="#313131" Offset="1"/>
              </LinearGradientBrush>
          </Border.Background>
          
          <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="GitHub Repository Tracker" Classes="Title"/>
              <Button Grid.Column="1" Content="History" Margin="0,0,14,0" Click="History_OnClick" VerticalAlignment="Center"/>
              <Image Grid.Column="2" Source="../resources/settings.png" Cursor="Hand" PointerPressed="InputElement_OnPointerPressed" Height="30" Width="30"/>
          </Grid>
      </Border>
      
    <Grid Grid.Row="1"
          ColumnDefinitions="1*,20,3*"
          Margin="0,20,0,0">

      <Border Grid.Column="0"
              CornerRadius="12"
              Padding="16">
          
          <Border.Background>
              <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                  <GradientStop Color="#2B2B35" Offset="0"/>
                  <GradientStop Color="#313131" Offset="1"/>
              </LinearGradientBrush>
          </Border.Background>
          
          <ScrollViewer>
            <StackPanel Spacing="10">
              <TextBlock Text="Add Repository" Classes="SubTitle"/>
              
              <TextBox Name="TbxUrl" Watermark="Repository-Url"/>
              
              <Label Content="--- or ---" FontSize="14" Margin="0 2 0 2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              
              <TextBox Name="TbxOwner" Watermark="Owner (e.g. torvalds)"/>
              <TextBox Name="TbxRepo" Watermark="Repository name (e.g. linux)"/>
              <Button Name="BtnAddRepo" Click="BtnAddRepo_OnClick" Content="Add Repository" Margin="0 0 0 40"/>

              <TextBlock Text="Local files" Classes="SubTitle"/>
              <Button Name="BtnInstallLocal" Click="InstallLocal_OnClick" Content="Install local file…" Margin="0 0 0 30"/>
              
              <TextBlock Text="Manage Personal Access Token" Classes="SubTitle"/>
              <TextBox Name="TbxPat" Watermark="Personal Access Token"/>
              <Button Name="BtnSetPat" Click="BtnSetPat_OnClick" Content="Set personal Access Token"/>
              <Button Name="BtnRemovePat" Click="BtnRemovePat_OnClick" Content="Remove personal Access Token" Background="#EC4C4C"/>
            </StackPanel>
          </ScrollViewer>
      </Border>

      <Border Grid.Column="2"
              CornerRadius="12"
              Padding="16">
          
          <Border.Background>
              <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                  <GradientStop Color="#2B2B35" Offset="0"/>
                  <GradientStop Color="#313131" Offset="1"/>
              </LinearGradientBrush>
          </Border.Background>
          
          <ThemeVariantScope RequestedThemeVariant="Dark">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
                <primitives:TabStrip Name="AppTabs" SelectedIndex="0" SelectionChanged="AppTabs_OnSelectionChanged" VerticalAlignment="Center">
                    <primitives:TabStripItem Content="Tracked Repositories"/>
                    <primitives:TabStripItem Content="Local apps"/>
                </primitives:TabStrip>
                <StackPanel Name="RepositoryActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Name="PgbDownloading" VerticalAlignment="Center" Background="Transparent"
                                IsVisible="False" PointerPressed="PgbDownloading_OnPointerPressed">
                        <ProgressBar IsIndeterminate="True" Margin="10"/>
                    </StackPanel>
                    <Button Name="BtnSearchForUpdates" Margin="10,0" Click="BtnSearchForUpdates_OnClick">Search for updates</Button>
                    <Button Name="BtnUpdateAll" Click="BtnUpdateAll_OnClick">Update Selected</Button>
                </StackPanel>
            </Grid>
            <Separator Grid.Row="1" Margin="0,5,0,25"/>
            <ScrollViewer Name="RepoScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="RepoList" ItemsSource="{Binding Repos}" ClipToBounds="True" Padding="0 4 0 0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:RepoEntryControl/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <views:LocalAppsView Name="LocalAppsPanel" Grid.Row="2" IsVisible="False" InstallRequested="InstallLocal_OnClick"/>
          </Grid>
          </ThemeVariantScope>
      </Border>

    </Grid>
    <Popup
        x:Name="ToastPopup"
        Placement="Bottom"
        HorizontalOffset="0"
        VerticalOffset="-40"
        IsLightDismissEnabled="False">

        <Border
            Background="#CC333333"
            CornerRadius="8"
            Padding="12"
            MaxWidth="400">

            <TextBlock
                x:Name="ToastText"
                Foreground="White"
                FontSize="14"
                TextWrapping="Wrap"/>
        </Border>
    </Popup>
    <Canvas Name="RepoDragOverlay" Grid.RowSpan="2" ZIndex="1000" IsHitTestVisible="False"/>
  </Grid>
</UserControl>
