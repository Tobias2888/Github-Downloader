<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Github_Downloader_lib.Models;assembly=Github-Downloader-lib"
        x:Class="Github_Downloader.Views.UninstallRepoDialog"
        x:DataType="models:Repo"
        Title="Uninstall application"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark" Background="#222226">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock Name="DialogQuestion" Text="Uninstall application?" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Name="AppName" Text="{Binding Name}" TextWrapping="Wrap" Foreground="#A5DEE0" FontSize="16"/>
        <TextBlock Name="UninstallDetails" TextWrapping="Wrap" Foreground="#DDD"/>
        <TextBlock Name="RepositoryNotice" Text="The repository stays tracked and is excluded from Update All."
                   IsVisible="{Binding CanUninstall}" TextWrapping="Wrap" Foreground="#AAA"/>
        <StackPanel Name="PackageFields" Spacing="8" IsVisible="{Binding NeedsDebianPackageName}">
            <TextBlock Text="Installed Debian package name" Foreground="White"/>
            <TextBlock Text="Enter the package name shown in your package manager."
                       TextWrapping="Wrap" FontSize="12" Foreground="#AAA"/>
            <TextBox Name="PackageName" Watermark="e.g. code or code:amd64" TextChanged="PackageName_OnTextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Cancel" Click="Cancel_OnClick" Padding="16,8"/>
            <Button Name="ConfirmUninstall" Content="Uninstall" Click="Uninstall_OnClick"
                    Background="#963B3B" Foreground="White" Padding="16,8"/>
        </StackPanel>
    </StackPanel>
</Window>
