<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Github_Downloader.ViewModels"
             xmlns:conv="clr-namespace:Github_Downloader.Converter"
             xmlns:ac="using:Avalonia.Controls"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Github_Downloader.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel"
             Background="#222226">
    
    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TimePicker">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="BorderBrush" Value="#44444E"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="TimePickerPresenter">
            <Setter Property="Background" Value="#2B2B35"/>
            <Setter Property="BorderBrush" Value="#44444E"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Keep the window's TextBlock margins out of the fixed-height time picker rows. -->
        <Style Selector="TimePickerPresenter /template/ primitives|DateTimePickerPanel TextBlock">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TimePickerPresenter /template/ primitives|DateTimePickerPanel ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TimePickerPresenter /template/ ScrollViewer">
            <Setter Property="IsScrollChainingEnabled" Value="False"/>
        </Style>

        <Style Selector="TimePickerPresenter /template/ Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="RadioButton.StateButton">
            <Setter Property="Background" Value="#2B2B35"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <Style Selector="RadioButton.StateButton:pointerover">
            <Setter Property="Background"
                    Value="#383842"/>
            
            <Setter Property="BorderBrush"
                    Value="#555"/>
        </Style>
        
        <Style Selector="RadioButton.StateButton:checked">
            <Setter Property="BorderBrush"
                    Value="#009EA4"/>
            
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%"
                                         EndPoint="0%,100%">
                        
                        <GradientStop Color="#3A3A42"
                                      Offset="0"/>
                        
                        <GradientStop Color="#2B2B35"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style Selector="PathIcon">
            <Setter Property="Foreground"
                    Value="White"/>
            
            <Setter Property="Width"
                    Value="32"/>
            
            <Setter Property="Height"
                    Value="32"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <Grid RowDefinitions="Auto,*"
          Margin="20">
        
        <Border CornerRadius="12"
                Padding="16">
            
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%"
                                     EndPoint="100%,50%">
                    
                    <GradientStop Color="#2B2B35"
                                  Offset="0"/>
                    
                    <GradientStop Color="#313131"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
          
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Settings"
                           VerticalAlignment="Center"
                           Classes="Title"/>
                
                <Image Source="../resources/close.png"
                       PointerPressed="ImgBack_OnPointerPressed"
                       Cursor="Hand"
                       HorizontalAlignment="Right"
                       Height="30" Width="30"
                       Grid.Column="1"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="1*,20,1*"
              Margin="0,20,0,0">
            
            <StackPanel Grid.Column="0"
                        Spacing="20">
                
                <Border CornerRadius="12"
                        Padding="16">
                    
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,100%"
                                             EndPoint="50%,0%">
                            
                            <GradientStop Color="#2B2B35"
                                          Offset="0"/>
                            
                            <GradientStop Color="#313131"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <StackPanel Spacing="15">
                        <TextBlock Text="Default Start Mode"
                                   Classes="SubTitle"/>
                        
                        <UniformGrid Columns="3"
                                     Margin="20 0 0 0">
                            
                            <RadioButton Classes="StateButton" 
                                         GroupName="WindowState"
                                         IsChecked="{Binding WindowState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ac:WindowState.Normal}, Mode=OneWay}"
                                         Command="{Binding SetWindowState}"
                                         CommandParameter="{x:Static ac:WindowState.Normal}">
                                
                                <StackPanel Spacing="10">
                                    <Image Source="../resources/normal.png"
                                           Width="125"/>
                                    
                                    <TextBlock Text="Normal"
                                               HorizontalAlignment="Center"
                                               FontSize="16"/>
                                </StackPanel>
                            </RadioButton>
                            
                            <RadioButton Classes="StateButton" 
                                         GroupName="WindowState"
                                         IsChecked="{Binding WindowState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ac:WindowState.Maximized}, Mode=OneWay}"
                                         Command="{Binding SetWindowState}"
                                         CommandParameter="{x:Static ac:WindowState.Maximized}">
                                
                                <StackPanel Spacing="10">
                                    <Image Source="../resources/maximize.png"
                                           Width="125"/>
                                    
                                    <TextBlock Text="Maximized"
                                               HorizontalAlignment="Center"
                                               FontSize="16"/>
                                </StackPanel>
                            </RadioButton>
                            
                            <RadioButton Classes="StateButton" 
                                         GroupName="WindowState"
                                         IsChecked="{Binding WindowState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ac:WindowState.FullScreen}, Mode=OneWay}"
                                         Command="{Binding SetWindowState}"
                                         CommandParameter="{x:Static ac:WindowState.FullScreen}">
                                
                                <StackPanel Spacing="10">
                                    <Image Source="../resources/fullscreen.png"
                                           Width="125"/>
                                    
                                    <TextBlock Text="Fullscreen"
                                               HorizontalAlignment="Center"
                                               FontSize="16"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="12"
                        Padding="16">
                    
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,100%"
                                             EndPoint="50%,0%">
                            
                            <GradientStop Color="#2B2B35"
                                          Offset="0"/>
                            
                            <GradientStop Color="#313131"
                                          Offset="1"/>
                            
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <StackPanel Spacing="15">
                        <TextBlock Text="Updates"
                                   Classes="SubTitle"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Automatically check for updates"
                                       VerticalAlignment="Center"/>
                            
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding AutoCheckForUpdates}"
                                          OnContent=""
                                          OffContent=""/>
                        </Grid>
                        
                        <StackPanel Spacing="5"
                                    IsEnabled="{Binding AutoCheckForUpdates}">
                            
                            <TextBlock Text="Check Interval (minutes)"/>
                            
                            <NumericUpDown Name="NudInterval"
                                           Value="{Binding CheckForUpdatesInterval}"
                                           Minimum="1"
                                           FormatString="F0"
                                           FontSize="16"
                                           VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12"
                        Padding="16">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,100%"
                                             EndPoint="50%,0%">

                            <GradientStop Color="#2B2B35"
                                          Offset="0"/>

                            <GradientStop Color="#313131"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel Spacing="15">
                        <TextBlock Text="Download Path"
                                   Classes="SubTitle"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Text="{Binding GlobalDownloadPath}"
                                     IsReadOnly="True"
                                     PlaceholderText="Select download directory..."
                                     IsEnabled="False"/>

                            <Button Grid.Column="1"
                                    Content="..."
                                    Margin="10,0,0,0"
                                    Padding="15,0"
                                    Height="30"
                                    Command="{Binding BrowseDownloadPath}"
                                    CommandParameter="{Binding $parent[UserControl]}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="12" Padding="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                            <GradientStop Color="#2B2B35" Offset="0"/>
                            <GradientStop Color="#313131" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="15">
                        <TextBlock Text="Default Asset Rule" Classes="SubTitle"/>
                        <TextBlock Text="Applied to new repositories. Existing repositories keep their own rules. Clear this rule to select files manually."
                                   TextWrapping="Wrap"/>
                        <TextBox Name="TbxDefaultAssetRule" Text="{Binding DefaultAssetRule, Mode=TwoWay}"
                                 PlaceholderText="e.g. *linux*x64*.AppImage" AcceptsReturn="True"
                                 MinLines="3" TextWrapping="Wrap"/>
                        <TextBlock Text="Separate case-sensitive globs with spaces or newlines: * matches any text, ? one character, {x64,amd64} either alias. Prefix a pattern with ! to exclude assets. Every inclusion must match; exclusions always win. At least one inclusion is required."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Padding="16" Background="#2B2B35">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Saved local installers" Classes="SubTitle"/>
                        <TextBlock Text="How many installer versions to keep per local app, including the newest."
                                   TextWrapping="Wrap"/>
                        <ComboBox Name="LocalInstallerRetentionModeSelector" SelectedIndex="{Binding LocalInstallerRetentionMode, Mode=TwoWay}">
                            <ComboBoxItem Content="Keep a limited number"/>
                            <ComboBoxItem Content="Unlimited (∞)"/>
                        </ComboBox>
                        <NumericUpDown Name="LocalInstallerVersionLimit" Value="{Binding LocalInstallerVersionsToKeep, Mode=TwoWay}"
                                       Minimum="0" Maximum="2147483647" Increment="1" FormatString="0"
                                       IsEnabled="{Binding LimitLocalInstallerVersions}"/>
                        <TextBlock Text="0 keeps no saved installers. Unlimited keeps every version. Saving deletes older saved copies beyond the limit; imported source files and installed apps are kept. Without a saved copy, reinstall by dropping the file again."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                        <Button Name="SaveLocalInstallerRetention" Content="Save and apply" Click="SaveLocalInstallerRetention_OnClick"/>
                        <TextBlock Name="LocalInstallerRetentionWarning" IsVisible="{Binding IsReducingLocalInstallerRetention}"
                                   Text="Lowering this limit may permanently delete previously saved installer versions."
                                   Foreground="#FFCF80" TextWrapping="Wrap"/>
                        <Border Name="LocalInstallerRetentionConfirmation" IsVisible="{Binding ShowLocalInstallerRetentionConfirmation}"
                                BorderBrush="#B98240" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Apply the lower limit and delete saved versions beyond it? This cannot be undone."
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Name="ConfirmLocalInstallerRetention" Content="Apply lower limit" Click="ConfirmLocalInstallerRetention_OnClick"/>
                                    <Button Name="CancelLocalInstallerRetention" Content="Cancel" Click="CancelLocalInstallerRetention_OnClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Name="LocalInstallerRetentionStatus" Text="{Binding LocalInstallerRetentionStatus}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Spacing="20">

                <Border CornerRadius="12"
                        Padding="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,100%"
                                             EndPoint="50%,0%">
                            <GradientStop Color="#2B2B35"
                                          Offset="0"/>
                            <GradientStop Color="#313131"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel Spacing="15">
                        <TextBlock Text="Notifications" Classes="SubTitle"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Enable desktop notifications" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch Name="TglNotifications" Grid.Column="1"
                                          IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                        </Grid>
                        <StackPanel Spacing="15" IsEnabled="{Binding NotificationsEnabled}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="New updates available" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyUpdatesAvailable, Mode=TwoWay}"
                                              OnContent="" OffContent=""/>
                            </Grid>
                            <StackPanel Spacing="8" IsEnabled="{Binding NotifyUpdatesAvailable}">
                                <TextBlock Text="Update notification frequency"/>
                                <ComboBox Name="UpdateNotificationModeSelector" HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding UpdateNotificationMode, Mode=TwoWay}">
                                    <ComboBoxItem Content="Once per new release"/>
                                    <ComboBoxItem Content="Repeat at a fixed interval"/>
                                </ComboBox>
                                <StackPanel Spacing="5" IsEnabled="{Binding RepeatUpdateNotifications}">
                                    <TextBlock Text="Reminder interval (minutes)"/>
                                    <NumericUpDown Name="UpdateReminderInterval" Minimum="1" Maximum="10080"
                                                   Increment="1" FormatString="F0" AllowSpin="True"
                                                   Value="{Binding UpdateReminderIntervalMinutes, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Text="The first alert is immediate. Repeated alerts continue while updates are pending, within your allowed hours. The app must remain running."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Downloads completed" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyDownloadsCompleted, Mode=TwoWay}"
                                              OnContent="" OffContent=""/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Only during these hours" VerticalAlignment="Center"/>
                                <ToggleSwitch Name="TglNotificationTimes" Grid.Column="1"
                                              IsChecked="{Binding LimitNotificationTimes, Mode=TwoWay}" OnContent="" OffContent=""/>
                            </Grid>
                            <ThemeVariantScope RequestedThemeVariant="Dark">
                                <Grid ColumnDefinitions="*,16,*" IsEnabled="{Binding LimitNotificationTimes}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="From"/>
                                        <TimePicker Name="NotificationStartPicker" ClockIdentifier="24HourClock"
                                                    TemplateApplied="NotificationTimePicker_OnTemplateApplied"
                                                    SelectedTime="{Binding NotificationStartTime, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Text="Until"/>
                                        <TimePicker Name="NotificationEndPicker" ClockIdentifier="24HourClock"
                                                    TemplateApplied="NotificationTimePicker_OnTemplateApplied"
                                                    SelectedTime="{Binding NotificationEndTime, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </ThemeVariantScope>
                            <TextBlock Text="Uses your computer's local time. Overnight ranges are supported; matching times allow all day."
                                       TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                            <TextBlock Text="Excluded repositories do not trigger update alerts. Update All sends one completion alert. Outside these hours, completion alerts are skipped; available updates can be announced when the window opens."
                                       TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                


                <Border CornerRadius="12"
                        Padding="16">
                    
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,100%"
                                             EndPoint="50%,0%">
                            
                            <GradientStop Color="#2B2B35"
                                          Offset="0"/>
                            
                            <GradientStop Color="#313131"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <StackPanel Spacing="15">
                        <TextBlock Text="Data Management"
                                   Classes="SubTitle"/>
                        
                        <Button Content="Import Repository Configuration" 
                                HorizontalAlignment="Stretch" 
                                Command="{Binding ImportConfig}"
                                CommandParameter="{Binding $parent[UserControl]}"/>
                        
                        <Button Content="Export Repository Configuration" 
                                HorizontalAlignment="Stretch"
                                Command="{Binding ExportConfig}"
                                CommandParameter="{Binding $parent[UserControl]}"/>

                        <TextBlock Text="Re-download and reinstall every tracked repository, including those excluded from bulk updates."
                                   TextWrapping="Wrap"/>
                        <Button Name="ReinstallAll" Content="Reinstall All Repositories"
                                HorizontalAlignment="Stretch" Click="ReinstallAll_OnClick"/>
                        <Border Name="ReinstallConfirmation" IsVisible="False" Background="#222226"
                                CornerRadius="6" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Name="ReinstallQuestion" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Name="CancelReinstall" Content="Cancel" Margin="0,0,10,6"
                                            Click="CancelReinstall_OnClick"/>
                                    <Button Name="ConfirmReinstall" Content="Reinstall All" Margin="0,0,0,6"
                                            Click="ConfirmReinstall_OnClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
