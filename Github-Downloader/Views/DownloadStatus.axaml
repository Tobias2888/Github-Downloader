<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Github_Downloader.ViewModels"
        xmlns:models="clr-namespace:Github_Downloader.Models"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="440"
        x:Class="Github_Downloader.DownloadStatus"
        x:DataType="viewModels:DownloadStatusViewModel"
        Title="Download Status"
        Width="500"
        Height="440"
        MinWidth="380"
        MinHeight="260"
        Background="#222226"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.log">
            <Setter Property="Foreground" Value="#C7C7C7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.log.detail">
            <Setter Property="Foreground" Value="#8A8A8A"/>
        </Style>
        <Style Selector="TextBlock.log.success">
            <Setter Property="Foreground" Value="#4CAF50"/>
        </Style>
        <Style Selector="TextBlock.log.error">
            <Setter Property="Foreground" Value="#EC4C4C"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding StatusText}"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="#EAEAEA"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Percent, StringFormat='{}{0:0}%'}"
                       IsVisible="{Binding !IsIndeterminate}"
                       Foreground="#009EA4"
                       FontSize="13"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       VerticalAlignment="Center"/>
        </Grid>

        <ProgressBar Grid.Row="1"
                     Margin="0,10,0,0"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding Percent}"
                     IsIndeterminate="{Binding IsIndeterminate}"/>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="#151518"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,6">

            <ScrollViewer Name="LogScroll">
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadLogEntry">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                <TextBlock Text="{Binding TimeText}"
                                           Foreground="#7A7A7A"
                                           FontSize="11"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           Classes="log"
                                           Classes.detail="{Binding IsDetail}"
                                           Classes.success="{Binding IsSuccess}"
                                           Classes.error="{Binding IsError}"
                                           FontSize="11"
                                           FontFamily="Cascadia Code, Consolas, monospace"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3"
                Content="Close"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Padding="20,4"
                Click="BtnClose_OnClick"/>
    </Grid>
</Window>