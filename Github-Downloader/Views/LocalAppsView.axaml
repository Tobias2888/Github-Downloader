<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Github_Downloader_lib.Models;assembly=Github-Downloader-lib"
             x:Class="Github_Downloader.Views.LocalAppsView" Loaded="OnLoaded">
    <Grid Margin="0,16,0,0" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Local apps" Classes="SubTitle" VerticalAlignment="Center"/>
            <Button Name="InstallLocal" Grid.Column="1" Content="Browse…" Click="Install_OnClick"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,12" Spacing="6">
            <TextBlock Text="Drop installers or archives onto this page to install local apps. Use Add version… on an archive app to update it from a renamed archive." Foreground="#C6DDDE" TextWrapping="Wrap"/>
            <TextBlock Name="ListStatus" Foreground="#AAA" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="AppsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LocalApp">
                        <Border Padding="16" Margin="0,0,0,10" Background="#2B2B35" CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White"/>
                                <TextBlock Grid.Row="1" Text="{Binding Type}" Foreground="#AAA"/>
                                <TextBlock Grid.Row="2" Text="{Binding FileName}" Foreground="#AAA" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#AAA"/>
                                <StackPanel Grid.Column="1" Grid.RowSpan="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Add version…" IsVisible="{Binding CanAddArchiveVersion}" Click="AddVersion_OnClick"/>
                                    <Button Content="Reinstall" IsVisible="{Binding CanReinstall}" Click="Reinstall_OnClick"/>
                                    <Button Content="Install version…" IsVisible="{Binding CanChooseInstallerVersion}" Click="InstallVersion_OnClick"/>
                                    <Button Content="Uninstall" IsVisible="{Binding CanUninstall}" Click="Uninstall_OnClick" Background="#963B3B"/>
                                    <Button Content="System uninstaller…" IsVisible="{Binding UseSystemUninstaller}" Click="SystemUninstaller_OnClick"/>
                                    <Button Content="Remove" Click="Remove_OnClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
