<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Github_Downloader_lib.Models;assembly=Github-Downloader-lib"
             x:Class="Github_Downloader.Views.LocalAppsView" Loaded="OnLoaded">
    <Grid Margin="0,16,0,0" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Locally installed apps" Classes="SubTitle" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh" Margin="0,0,12,0" Click="Refresh_OnClick"/>
            <Button Name="InstallLocal" Grid.Column="2" Content="Install local file…" Click="Install_OnClick"/>
        </Grid>
        <TextBlock Name="ListStatus" Grid.Row="1" Margin="0,12" Foreground="#AAA" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="AppsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LocalApp">
                        <Border Padding="16" Margin="0,0,0,10" Background="#2B2B35" CornerRadius="8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White"/>
                                <TextBlock Grid.Row="1" Text="{Binding Type}" Foreground="#AAA"/>
                                <TextBlock Grid.Row="2" Text="{Binding FileName}" Foreground="#AAA" TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Reinstall" IsVisible="{Binding CanReinstall}" Click="Reinstall_OnClick"/>
                                    <Button Content="Uninstall" IsVisible="{Binding CanUninstall}" Click="Uninstall_OnClick" Background="#963B3B"/>
                                    <Button Content="System uninstaller…" IsVisible="{Binding UseSystemUninstaller}" Click="SystemUninstaller_OnClick"/>
                                    <Button Content="Remove from list" IsVisible="{Binding NeedsManualRemoval}" Click="Forget_OnClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
