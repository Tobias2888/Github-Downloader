<Styles xmlns="https://github.com/avaloniaui"
        xmlns:ctxt="using:ColorTextBlock.Avalonia"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:mdc="using:Markdown.Avalonia.Controls">
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#E6E6E6"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
        <Setter Property="LineSpacing" Value="3"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading1">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Margin" Value="0,20,0,10"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading2">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F4F4F4"/>
        <Setter Property="Margin" Value="0,18,0,8"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading3">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#EFEFEF"/>
        <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading4">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading5">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading6">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#9AA0A6"/>
        <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CHyperlink">
        <Setter Property="IsUnderline" Value="True"/>
        <Setter Property="Foreground" Value="#00B1B6"/>
        <Setter Property="HoverForeground" Value="#FFFFFF"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CCode">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
        <Setter Property="Foreground" Value="#E6C07B"/>
        <Setter Property="Background" Value="#2E2E3A"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.CodeBlock">
        <Setter Property="Background" Value="#26262E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#3A3A44"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock.CodeBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
        <Setter Property="Foreground" Value="#C8C8C8"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer .CodeBlock edit|TextEditor">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#C8C8C8"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.List">
        <Setter Property="Margin" Value="24,4,0,8"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.ListMarker">
        <Setter Property="Margin" Value="0,6,8,6"/>
        <Setter Property="Foreground" Value="#9AA0A6"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Blockquote">
        <Setter Property="BorderBrush" Value="#009EA4"/>
        <Setter Property="BorderThickness" Value="4,0,0,0"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer StackPanel.Blockquote">
        <Setter Property="Margin" Value="14,4"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer .Blockquote ctxt|CTextBlock">
        <Setter Property="Foreground" Value="#9AA0A6"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Table">
        <Setter Property="Margin" Value="0,10"/>
        <Setter Property="BorderBrush" Value="#4A4A56"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.Table > Border">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="#4A4A56"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader">
        <Setter Property="Background" Value="#2B2B35"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.EvenTableRow">
        <Setter Property="Background" Value="#28282E"/>
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer mdc|Rule">
        <Setter Property="Margin" Value="0,16"/>
    </Style>
</Styles>
