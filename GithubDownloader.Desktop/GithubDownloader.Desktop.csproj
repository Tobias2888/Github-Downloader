<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <NoWarn>CS8767;CS8600;CS8618;CS8602;CS8604;CS8601;CS4014</NoWarn>
        <OutputType>WinExe</OutputType>
        <AssemblyName>Github-Downloader</AssemblyName>
        <RootNamespace>GithubDownloader.Desktop</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GithubDownloader.Tests" />
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <AvaloniaResource Include="resources/**" />
        <PackageReference Include="Markdown.Avalonia" Version="12.0.2" />
        <PackageReference Include="Markdig" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\MainWindow.axaml.cs">
        <DependentUpon>MainWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="App.axaml.cs">
        <DependentUpon>App.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\DownloadStatus.axaml.cs">
        <DependentUpon>DownloadStatus.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\RepoEntryControl.axaml.cs">
        <DependentUpon>RepoEntryControl.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <None Update="resources\icon.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GithubDownloader.Core\GithubDownloader.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../libs/FileLib/FileLib/FileLib.csproj" />
      <ProjectReference Include="../libs/LoggerLib/LoggerLib/LoggerLib.csproj" />
      <ProjectReference Include="../libs/SecretsLib/SecretsLib/SecretsLib.csproj" />
    </ItemGroup>
</Project>
