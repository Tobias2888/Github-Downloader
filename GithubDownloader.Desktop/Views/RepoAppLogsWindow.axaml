<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:GithubDownloader.Desktop.Services"
        x:Class="GithubDownloader.Desktop.Views.RepoAppLogsWindow"
        x:DataType="services:RepoAppLogSession"
        Title="Application Logs"
        Width="760" Height="520" MinWidth="420" MinHeight="280"
        Background="#222226" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="#EAEAEA"/>
            <TextBlock Text="Live stdout and stderr from this GHD-launched session. Output is kept in memory only."
                       Foreground="#AAA" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,12" Background="#151518" BorderBrush="#3A3A3A"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer Name="LogScroll">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#C7C7C7" FontSize="11"
                                       FontFamily="Cascadia Code, Consolas, monospace" TextWrapping="Wrap" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Padding="20,4"
                Click="Close_OnClick"/>
    </Grid>
</Window>
