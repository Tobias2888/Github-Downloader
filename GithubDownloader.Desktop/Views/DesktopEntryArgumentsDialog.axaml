<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GithubDownloader.Desktop.Views.DesktopEntryArgumentsDialog"
        Title="Desktop-entry arguments" Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" RequestedThemeVariant="Dark" Background="#222226">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="Launch arguments" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Text="Arguments passed when launching from the application menu."
                   TextWrapping="Wrap" Foreground="#DDD"/>
        <StackPanel Spacing="8">
            <TextBlock Text="Arguments" Foreground="White"/>
            <TextBox Name="ArgumentsInput" PlaceholderText="--example &quot;value with spaces&quot;"/>
            <TextBlock Text="Separate arguments with spaces; quote values containing spaces. Clear to remove."
                       TextWrapping="Wrap" FontSize="12" Foreground="#AAA"/>
        </StackPanel>
        <TextBlock Name="SaveError" IsVisible="False" TextWrapping="Wrap" Foreground="#FF9999"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Cancel" Click="Cancel_OnClick" Padding="16,8"/>
            <Button Name="SaveArguments" Content="Save" Click="Save_OnClick" Padding="16,8"/>
        </StackPanel>
    </StackPanel>
</Window>
